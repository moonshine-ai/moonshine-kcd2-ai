// What Windows shows of Moonshine.exe: its icon, and its name and version in Explorer and
// Task Manager. Filled in by CMake (app/CMakeLists.txt).
//
// The icon is under 32512 because that is the number of IDI_APPLICATION, which is what the
// window library asks this program for when it makes the window; the first icon in a
// program is also the one Explorer shows for the file.
32512 ICON "@MOONSHINE_ICON@"

1 VERSIONINFO
FILEVERSION @MOONSHINE_VERSION_COMMAS@
PRODUCTVERSION @MOONSHINE_VERSION_COMMAS@
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Pete Warden"
            VALUE "FileDescription", "Moonshine"
            VALUE "FileVersion", "@MOONSHINE_VERSION@"
            VALUE "InternalName", "Moonshine"
            VALUE "OriginalFilename", "Moonshine.exe"
            VALUE "ProductName", "Moonshine for Kingdom Come: Deliverance 2"
            VALUE "ProductVersion", "@MOONSHINE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
